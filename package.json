{
  "name": "look-md",
  "private": true,
  "version": "1.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/promise-zb/look-md.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "icons": "swift scripts/make-icon.swift icon-src.png && tauri icon icon-src.png -o src-tauri/icons && rm -rf src-tauri/icons/ios src-tauri/icons/android src-tauri/icons/Square*.png src-tauri/icons/StoreLogo.png src-tauri/icons/64x64.png src-tauri/icons/icon.png",
    "pack": "node scripts/pack.mjs",
    "pack:mac": "node scripts/pack.mjs mac",
    "pack:win": "node scripts/pack.mjs win"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.4"
  }
}
